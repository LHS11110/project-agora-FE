VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# Optional direct WebSocket hostname for Vite development.
VITE_CPP_WS_HOST=127.0.0.1

# Optional WebSocket origin, e.g. wss://agora.example.com
VITE_WS_BASE_URL=
