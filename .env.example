# VITE_* values are included in the browser bundle; do not put secrets here.
# Spring Boot API URL. Leave blank to use same-origin requests in production.
VITE_API_BASE_URL=
# Development-only Vite proxy target for /api requests.
VITE_API_PROXY_TARGET=https://localhost:8443

# Docker development proxy through the backend-owned Nginx network.
VITE_DOCKER_API_PROXY_TARGET=https://agora-nginx

# HTTPS gateway uses port 8443; Vite is an internal TLS service in Docker.
VITE_PORT=5173


# Optional public Vite hostnames, comma-separated; localhost/IPs work by default.
VITE_ALLOWED_HOSTS=

# Optional WebSocket origin. Docker defaults to the current browser origin.
VITE_WS_BASE_URL=

# Optional JSON array for WebRTC ICE servers. Defaults to a public STUN endpoint.
# For restricted NATs, use your own TURN service and short-lived credentials.
# TURN credentials are sent to browsers, so never use long-lived secrets here.
# VITE_WEBRTC_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"<temporary-user>","credential":"<temporary-password>"}]
